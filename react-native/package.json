{
  "name": "@watchupltd/react-native",
  "version": "0.2.0",
  "description": "Official WatchUp SDK for React Native and Expo - JS errors, logs, events, and traces",
  "license": "MIT",
  "author": "Watchup Ltd",
  "homepage": "https://watchup.site/docs/sdks/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomurashigaraki22/watchup-v3-packages.git",
    "directory": "react-native"
  },
  "keywords": [
    "watchup",
    "react-native",
    "expo",
    "monitoring",
    "observability",
    "error-tracking",
    "logging"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run --root .. --project react-native"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-community/netinfo": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "@watchupltd/core": "*"
  },
  "react-native": "./dist/index.js"
}
