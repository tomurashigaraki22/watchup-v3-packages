{
  "schema_version": "2.0",
  "tools": [
    {
      "name": "watchup_create_bug_report",
      "description": "Create a community bug report with optional linked WatchUp evidence. Requires WATCHUP_TOKEN and WATCHUP_READ_ONLY=false.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20000
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "affected_feature": {
            "type": "string",
            "maxLength": 200
          },
          "project_id": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "error",
              "log",
              "trace",
              "alert",
              "manual"
            ]
          },
          "evidence_id": {
            "type": "string",
            "maxLength": 100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 10
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "watchup_create_community_post",
      "description": "Create a community discussion, feature request, or bug report. Requires WATCHUP_TOKEN and WATCHUP_READ_ONLY=false.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "discussion",
              "feature_request",
              "bug_report"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 10
          },
          "project_id": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "title",
          "body"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "watchup_create_feature_flag",
      "description": "Create a feature flag for a project. Requires WATCHUP_TOKEN and WATCHUP_READ_ONLY=false.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "enabled": {
            "type": "boolean"
          },
          "rollout_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "key",
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "watchup_get_overview",
      "description": "Fetch the project overview: health, throughput, latency, recent activity, and readiness state.",
      "inputSchema": {
        "type": "object",
