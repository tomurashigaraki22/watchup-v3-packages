{
  "name": "@watchupltd/mcp",
  "version": "0.2.0",
  "description": "MCP server for WatchUp production context",
  "license": "MIT",
  "author": "Watchup Ltd",
  "homepage": "https://watchup.site/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomurashigaraki22/watchup-v3-packages.git",
    "directory": "mcp"
  },
  "keywords": [
    "watchup",
    "mcp",
    "model-context-protocol",
    "monitoring",
    "observability",
    "ai"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "watchup-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tool-schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "schema": "node dist/index.js --print-schema > tool-schema.json",
    "test": "vitest run --root .. --project mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "@watchupltd/core": "*"
  }
}
