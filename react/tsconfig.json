{
  "compilerOptions": {
    "target":           "ES2019",
    "lib":              ["ES2019", "DOM", "DOM.Iterable"],
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "jsx":              "react-jsx",
    "strict":           true,
    "skipLibCheck":     true,
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "outDir":           "dist",
    "rootDir":          "src"
  },
  "include": ["src"]
}
