{
  "name": "@watchupltd/node",
  "version": "0.3.0",
  "description": "Official Watchup SDK for Node.js and Express",
  "license": "MIT",
  "author": "Watchup Ltd",
  "homepage": "https://watchup.site/docs/sdks/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomurashigaraki22/watchup-v3-packages.git",
    "directory": "node"
  },
  "keywords": [
    "watchup",
    "monitoring",
    "observability",
    "apm",
    "tracing",
    "express",
    "nodejs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run --root .. --project node"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "@watchupltd/core": "*"
  }
}
